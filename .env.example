# Ambiente: development ou production
VITE_ENVIRONMENT=development

# Usar localhost (true) ou servidor remoto (false)
VITE_USE_LOCALHOST=true

# URLs de Backend
VITE_BACKEND_DEV_URL=http://localhost:3000
VITE_BACKEND_PROD_URL=https://api.seu-dominio.com

# Ably realtime
# Preferir authUrl/token auth em producao para nao expor uma API key completa no bundle.
VITE_ABLY_AUTH_URL=https://api.seu-dominio.com/ably/auth
VITE_ABLY_API_KEY=your-ably-api-key-here

# YouTube Channel ID
VITE_YOUTUBE_CHANNEL_ID=UC...

# YouTube API Key
VITE_YOUTUBE_API_KEY=AI...

# Senha de acesso do site privado
VITE_SITE_PASSWORD=sua-senha-aqui

# URL publica deste front (SPA)
VITE_APP_URL=https://app.tiagofuguete.com.br

# Pagina WordPress que embute o app em iframe
VITE_WORDPRESS_EMBED_URL=https://tiagofuguete.com.br/torneios

# Google AdSense — subdominio app.tiagofuguete.com.br (requer public/ads.txt no deploy)
VITE_ADSENSE_ENABLED=true
