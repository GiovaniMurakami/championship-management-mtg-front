# Ambiente: development ou production
VITE_ENVIRONMENT=development

# Usar localhost (true) ou servidor remoto (false)
VITE_USE_LOCALHOST=true

# URLs de Backend
VITE_BACKEND_DEV_URL=http://localhost:3000
VITE_BACKEND_PROD_URL=https://api.tiagofuguete.com.br

# Ably realtime
# Preferir authUrl/token auth em producao para nao expor uma API key completa no bundle.
VITE_ABLY_AUTH_URL=https://api.tiagofuguete.com.br/ably/auth
VITE_ABLY_API_KEY=your-ably-api-key-here

# YouTube Channel ID
VITE_YOUTUBE_CHANNEL_ID=UC...

# YouTube API Key
VITE_YOUTUBE_API_KEY=AI...

# Senha de acesso do site privado
VITE_SITE_PASSWORD=sua-senha-aqui

# UUID do usuário Tiago Fuguete (decks públicos em /decks-fuguete)
VITE_FUGUETE_USER_ID=

# URL publica deste front (SPA no apex; homolog: https://homolog.tiagofuguete.com.br)
VITE_APP_URL=https://tiagofuguete.com.br

# Google AdSense — host deve bater com VITE_APP_URL (requer public/ads.txt no deploy)
VITE_ADSENSE_ENABLED=true

# Analytics (mesmos IDs do WordPress; só carregam após "Aceitar todos" no banner de cookies)
VITE_GTM_ID=GTM-K3QJVXGB
VITE_GA_MEASUREMENT_ID=G-BN7JN9ET38
VITE_GOOGLE_TAG_ID=GT-T5JV5Q7T
